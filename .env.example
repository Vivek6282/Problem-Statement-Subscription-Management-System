# Brightloop Environment Configuration

# Django Settings
DEBUG=True
SECRET_KEY=brightloop-dev-insecure-secret-key-change-in-production-12345
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
# For PostgreSQL (default in Docker / production):
DATABASE_URL=postgres://brightloop:brightloop@localhost:5432/brightloop_db
# Set USE_SQLITE=True to fallback to local SQLite for instant testing without Postgres running
USE_SQLITE=False

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS / CSRF Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Email Backend (Console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=billing@brightloop.io


# Reporting
# ISO 4217 code shown on admin reports and exports. Amounts are not converted.
CURRENCY_CODE=USD
# IANA timezone that defines "today" and month boundaries in admin reports.
BUSINESS_TIMEZONE=Asia/Kolkata

# Optional AI assistant (admin-only drafts; off by default). Never commit real keys.
AI_ENABLED=False
# anthropic or fake (fake returns canned text, for local testing)
AI_PROVIDER=fake
# Only read when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Required when AI_PROVIDER=anthropic. For short drafts a small model such as claude-haiku-5-5 is suggested.
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=400
AI_MAX_INPUT_CHARS=4000
