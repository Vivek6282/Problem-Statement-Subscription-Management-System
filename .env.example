# Brightloop Environment Configuration

# Django Settings
DEBUG=True
SECRET_KEY=brightloop-dev-insecure-secret-key-change-in-production-12345
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
# For PostgreSQL (default in Docker / production):
DATABASE_URL=postgres://brightloop:brightloop@localhost:5432/brightloop_db
# Set USE_SQLITE=True to fallback to local SQLite for instant testing without Postgres running
USE_SQLITE=False

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS / CSRF Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Email Backend (Console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=billing@brightloop.io


# Public URL of the frontend (used to build password-reset links) and reset-link lifetime
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT_SECONDS=3600

# Real email delivery (set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Scheduler (UTC) for the daily recurring-billing run, and auth endpoint throttle
BILLING_CRON_HOUR=0
BILLING_CRON_MINUTE=5
AUTH_THROTTLE_RATE=30/min
